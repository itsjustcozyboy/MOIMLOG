# Console 조직 Limits에 맞게 낮추세요. 다른 앱의 사용량은 반영되지 않습니다.
GROQ_RPM=20
GROQ_RPD=2000
GROQ_ASH=7200
GROQ_ASD=28800
GROQ_TEXT_RPM=30
GROQ_TEXT_RPD=1000
GROQ_TEXT_TPM=8000
GROQ_TEXT_TPD=200000
