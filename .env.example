# API keys stay on the backend. Empty keys enable local review only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET=
DATA_DIR=backend/data
# Set true when served through HTTPS (production / public Codespaces).
COOKIE_SECURE=false
# Optional override; normally uses DATA_DIR/moimlog.db
# DATABASE_URL=sqlite:///backend/data/moimlog.db

GROQ_API_KEY=
USD_KRW=1500
AI_MONTHLY_BUDGET_KRW=5000
# Set verified model prices before enabling paid analysis.
OPENAI_INPUT_USD_PER_MILLION=0
OPENAI_OUTPUT_USD_PER_MILLION=0

# Actual organization limits from https://console.groq.com/settings/limits
GROQ_RPM=20
GROQ_RPD=2000
GROQ_ASH=7200
GROQ_ASD=28800
